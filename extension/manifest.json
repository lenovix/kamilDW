{
  "manifest_version": 3,
  "name": "kamilDW Download Interceptor",
  "version": "1.0.0",
  "description": "Browser extension to capture downloads and sniff media streams for kamilDW Desktop Manager.",
  "permissions": [
    "downloads",
    "contextMenus",
    "webRequest",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "kamilDW Helper"
  }
}
